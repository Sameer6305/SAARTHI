# SAARTHI Cloud Backend - Environment Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# Application Settings
# =============================================================================

# Application environment: development, staging, production
ENVIRONMENT=development

# Enable debug mode (enables docs, reload, verbose logging)
DEBUG=true

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json (production) or console (development)
LOG_FORMAT=console

# =============================================================================
# Server Settings
# =============================================================================

# Server host (0.0.0.0 for all interfaces)
HOST=0.0.0.0

# Server port
PORT=8000

# =============================================================================
# Security Settings
# =============================================================================

# CORS allowed origins (comma-separated for multiple)
CORS_ORIGINS=["http://localhost:3000"]

# =============================================================================
# Memory Configuration
# =============================================================================

# Maximum STM entries per task
STM_MAX_ENTRIES_PER_TASK=100

# Maximum size per STM entry (bytes)
STM_ENTRY_MAX_SIZE_BYTES=10240

# Maximum LTM results per query
LTM_MAX_RESULTS_PER_QUERY=10

# =============================================================================
# Planner Configuration
# =============================================================================

# Maximum steps in a plan
PLANNER_MAX_STEPS=20

# Planner timeout (seconds)
PLANNER_TIMEOUT_SECONDS=30.0
